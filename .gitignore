.env
.env.local

# Standalone wasm guest build artifacts (own workspaces, wasm32-wasip2 target)
wasm-fixtures/**/target/
crates/connectors/**/target/

# Leptos UI build artifacts (embedded at build time, not committed)
weir-ui/dist/
weir-ui/target/

# Connector test secrets ([[WEIR-I-0014]]): plaintext API keys are NEVER committed.
# Only the sops-encrypted *.enc.json bundles, *.example.json templates, and the
# README are tracked. (*.enc.json also matches *.json, so it must be re-included.)
/secrets/*.json
!/secrets/*.enc.json
!/secrets/*.example.json
